# Required: Your Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Required: Resend API key from resend.com (free tier = 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Required: Email address(es) to send the newsletter to (comma-separated)
EMAIL_TO=you@example.com

# Required: Verified sender address in Resend (must verify domain or use onboarding@resend.dev for testing)
EMAIL_FROM=newsletter@yourdomain.com

# Optional: OpenWeatherMap API key (free tier) for weather data
# Get one at https://openweathermap.org/api — takes ~2 hours to activate
OPENWEATHER_API_KEY=your_openweather_key_here
